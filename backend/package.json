{
  "name": "pure-kanban-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:cache:generate": "ts-node -r tsconfig-paths/register ./node_modules/.bin/mikro-orm cache:generate --combined --config src/db/mikro-orm.config.ts",
    "db:schema:create": "ts-node -r tsconfig-paths/register ./node_modules/.bin/mikro-orm schema:create --run --config src/db/mikro-orm.config.ts",
    "db:schema:fresh": "ts-node -r tsconfig-paths/register ./node_modules/.bin/mikro-orm schema:fresh --run --config src/db/mikro-orm.config.ts",
    "db:seeder:run": "ts-node -r tsconfig-paths/register ./node_modules/.bin/mikro-orm seeder:run --config src/db/mikro-orm.config.ts",
    "db:migration:create-blank": "ts-node -r tsconfig-paths/register ./node_modules/.bin/mikro-orm migration:create --blank --name --config src/db/mikro-orm.config.ts",
    "db:migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/.bin/mikro-orm migration:create --name --config src/db/mikro-orm.config.ts",
    "db:migration:up": "ts-node -r tsconfig-paths/register ./node_modules/.bin/mikro-orm migration:up --config src/db/mikro-orm.config.ts",
    "db:migration:down": "ts-node -r tsconfig-paths/register ./node_modules/.bin/mikro-orm migration:down --config src/db/mikro-orm.config.ts",
    "docker:build": "docker build -t pure-kanban-backend .",
    "docker:run": "docker run --env-file .env --name pure-kanban-backend -p 5000:5000 pure-kanban-backend"
  },
  "dependencies": {
    "@apollo/server": "^5.5.0",
    "@as-integrations/express5": "^1.1.2",
    "@faker-js/faker": "^10.4.0",
    "@mikro-orm/cli": "^7.1.4",
    "@mikro-orm/core": "^7.1.4",
    "@mikro-orm/entity-generator": "^7.1.4",
    "@mikro-orm/migrations": "^7.1.4",
    "@mikro-orm/nestjs": "^7.0.1",
    "@mikro-orm/postgresql": "^7.1.4",
    "@mikro-orm/reflection": "^7.2.0",
    "@mikro-orm/seeder": "^7.1.4",
    "@nestjs/apollo": "^13.2.5",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/graphql": "^13.2.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "bcrypt": "^6.0.0",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dataloader": "^2.2.3",
    "dotenv": "^17.4.2",
    "graphql": "^16.13.2",
    "graphql-scalars": "^1.25.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.2.0",
    "lexorank": "^1.0.5",
    "lodash": "^4.18.1",
    "mikro-orm": "^7.0.10",
    "nanoid": "^5.1.9",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "mikro-orm": {
    "useTsNode": true
  }
}
